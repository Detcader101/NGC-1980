{
  "name": "drop",
  "query": "?debug&kb&peace&res=0.45",
  "steps": [
    "waitFor 10000 window.__G",
    "key tap Enter", "wait 1200",
    "log set down broken on WELLSPRING (off the pad) and radio for the para team, hands off",
    "eval (()=>{ const I=__G.ISLANDS.find(i=>i.name==='WELLSPRING'); let best=null; for(let a=0;a<6.28;a+=0.3) for(let r=8;r<60;r+=4){ const x=I.x+Math.cos(a)*r, z=I.z+Math.sin(a)*r, h=__G.terrainH(x,z); if(h>2 && Math.hypot(x-I.pad.x,z-I.pad.z)>18 && (!best||Math.abs(h-I.pad.h)<Math.abs(best.h-I.pad.h))) best={x,z,h}; } __G.H.reset(new __G.THREE.Vector3(best.x, best.h+1.2, best.z), 0, true, 0); __G.D.hp.rotor=0.3; __G.D.hp.tail=0.2; __G.G.fuel=8; window.__b=best; return best })()",
    "wait 1500",
    "eval (__G.callLogistics(), !!__G.G.rescue)",
    "waitFor 4000 __G.drop.active",
    "eval ({d: Math.round(__G.drop.state.plane.p.distanceTo(__G.drop.state.target)), wind: __G.drop.state.wind})",
    "waitFor 40000 __G.drop.state.phase === 'run'",
    "wait 2500",
    "shot 01-jump-run",
    "waitFor 40000 __G.drop.state.jumpers.length > 0",
    "wait 4000",
    "shot 02-canopies",
    "waitFor 40000 __G.drop.state.jumpers.some(j=>j.state==='run' || j.state==='work')",
    "eval __G.drop.state.jumpers.map(j=>({s:j.state, d:Math.round(Math.hypot(j.p.x-__b.x,j.p.z-__b.z))}))",
    "wait 1500",
    "shot 03-landed",
    "waitFor 40000 __G.drop.state.fixed",
    "eval ({rotor:__G.D.hp.rotor, tail:__G.D.hp.tail, fuel:Math.round(__G.G.fuel), rescue:__G.G.rescue, jumpers:__G.drop.state.jumpers.map(j=>j.state)})",
    "expect __G.D.hp.rotor > 0.5 && __G.G.fuel > 20",
    "waitFor 5000 __G.G.rescue === null",
    "wait 1500",
    "shot 04-repaired",
    "log manual: steer the dropship and jump by hand",
    "eval (__G.D.hp.rotor=0.3, __G.callLogistics(), 1)",
    "waitFor 4000 __G.drop.active && __G.drop.state.phase",
    "waitFor 40000 __G.drop.state.phase === 'run'",
    "key down KeyD", "wait 1200", "key up KeyD",
    "expect __G.drop.state.handsOffPass === false",
    "waitFor 30000 (()=>{ const M=__G.drop.state, P=M.plane; return Math.hypot(P.p.x-M.target.x, P.p.z-M.target.z) < 140 })()",
    "key down KeyF", "wait 1600", "key up KeyF",
    "expect __G.drop.state.left < 3",
    "waitFor 20000 __G.drop.state.left === 0 && __G.drop.state.jumpers.some(j=>j.state==='canopy')",
    "key down KeyA", "wait 800",
    "shot 05-steering-canopy",
    "key up KeyA",
    "waitFor 60000 !__G.drop.state || __G.drop.state.done",
    "eval __G.drop.state && __G.drop.state.jumpers.map(j=>j.state)"
  ]
}
