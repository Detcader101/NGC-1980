{
  "name": "damage",
  "query": "?debug&kb&peace&res=0.45",
  "steps": [
    "waitFor 10000 window.__G",
    "eval (window.__msgs=[], new MutationObserver(()=>{const t=document.getElementById('msg').textContent; if(t) __msgs.push(Math.round(performance.now())+' '+t)}).observe(document.getElementById('msg'),{childList:true,subtree:true,characterData:true}), 1)",
    "key tap Enter",
    "wait 400",
    "log 1) tail rotor shot away in a hover -> death spin",
    "eval (__G.H.reset(new __G.THREE.Vector3(__G.HOME_B.x+36.0, 45, __G.HOME_B.z+54.0), 0.8, false, 1), __G.HI.setCollective(0.48), 1)",
    "wait 1500",
    "eval (__G.D.hp.tail = 0, __G.hurtHeli(0, 'TEST', 'tail'), 1)",
    "wait 2500",
    "eval ({yawRate:+__G.H.w.y.toFixed(2), tail:__G.D.hp.tail, cautions:__G.D.cautions(__G.G.fuel,__G.H.rpm,false).map(c=>c.t)})",
    "waitFor 6000 Math.abs(__G.H.w.y) > 1",
    "shot 01-death-spin",
    "log 2) cut the engine (I): no torque, the spin dies away; autorotate down with a flare",
    "key tap KeyI",
    "eval (window.__ap = setInterval(()=>{ const H=__G.H; const tgt = Math.max(1.2, H.agl * 0.45); __G.HI.setCollective(H.landed ? 0 : Math.min(0.95, Math.max(0.2, 0.42 + (-H.vel.y - tgt) * 0.12))); }, 16), 1)",
    "wait 3000",
    "eval ({yawRate:+__G.H.w.y.toFixed(2), driven:__G.H.driven, rpm:+__G.H.rpm.toFixed(2)})",
    "expect Math.abs(__G.H.w.y) < 0.6 && !__G.H.driven",
    "waitFor 25000 __G.H.landed || !__G.Z.alive",
    "eval (clearInterval(__ap), {landed:__G.H.landed, alive:__G.Z.alive, lives:__G.G.lives})",
    "expect __G.H.landed && __G.Z.alive && __G.G.lives===3",
    "shot 02-autorotated-down",
    "log 3) field repair: call logistics (L), engine back on (I), lift off again",
    "key tap KeyL",
    "expect !!__G.G.rescue",
    "eval (__G.G.rescue.t = 1.5, 1)",
    "waitFor 6000 !__G.G.rescue",
    "eval ({tail:__G.D.hp.tail, fuel:+__G.G.fuel.toFixed(1)})",
    "expect __G.D.hp.tail >= 0.6 && __G.G.fuel >= 49",
    "key tap KeyI",
    "eval (__G.HI.setCollective(0.65), 1)",
    "wait 6000",
    "eval ({landed:__G.H.landed, rpm:+__G.H.rpm.toFixed(2), agl:+__G.H.agl.toFixed(1), yawRate:+__G.H.w.y.toFixed(2)})",
    "expect !__G.H.landed && __G.H.agl > 3 && Math.abs(__G.H.w.y) < 0.5",
    "log 4) engine fire burns the engine; extinguisher (O) puts it out",
    "eval (__G.HI.setCollective(0.48), __G.D.hp.engine = 0.35, __G.D.fire = true, window.__e0 = __G.D.hp.engine, 1)",
    "wait 2000",
    "expect __G.D.hp.engine < __e0",
    "shot 03-engine-fire",
    "key tap KeyO",
    "expect !__G.D.fire",
    "log 5) leaking tank drains fuel faster than the burn",
    "eval (__G.D.hp.fuel = 0.2, window.__f0 = __G.G.fuel, 1)",
    "wait 2000",
    "eval ({lost:+(__f0 - __G.G.fuel).toFixed(2)})",
    "expect __f0 - __G.G.fuel > 1.2",
    "log 6) hits break parts but don't kill: six bullet hits",
    "eval ([1,2,3,4,5,6].forEach(()=>__G.hurtHeli(0.22,'HIT')), {alive:__G.Z.alive, hp:JSON.stringify(__G.D.hp)})",
    "expect __G.Z.alive",
    "log 7) home pad repairs everything",
    "eval (__G.D.hp.fuel = 1, __G.H.reset(new __G.THREE.Vector3(__G.PAD.x, __G.HOME_B.h + 1.15, __G.PAD.z), 0, true, 1), __G.HI.setCollective(0), 1)",
    "wait 5000",
    "eval ({damaged:__G.D.damaged(), hp:JSON.stringify(__G.D.hp)})",
    "expect !__G.D.damaged()",
    "eval window.__msgs"
  ]
}