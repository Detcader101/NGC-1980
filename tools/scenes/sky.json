{
  "name": "sky",
  "query": "?debug&kb&peace&res=0.45",
  "steps": [
    "waitFor 10000 window.__G",
    "key tap Enter", "wait 1200",
    "log buy the SKY CARRIER refit (5) and watch the fans fold out",
    "eval (__G.G.mat = 500, __G.command(6), {sky:!!__G.war.carrier.sky, mat:__G.G.mat})",
    "expect !!__G.war.carrier.sky && __G.G.mat === 200",
    "eval (__G.war.carrier.sky.refit = 7, 1)",
    "key tap KeyC", "wait 4500",
    "shot 01-fans-unfolding",
    "waitFor 8000 __G.war.carrier.sky.up",
    "wait 14000",
    "eval ({y:+__G.war.carrier.p.y.toFixed(1), heliY:+__G.H.pos.y.toFixed(1), landed:__G.H.landed})",
    "expect __G.war.carrier.p.y > 10 && __G.H.landed && __G.H.pos.y > __G.war.carrier.p.y + 7",
    "shot 02-lifting",
    "log take the helm: the bridge",
    "key tap Tab", "wait 1500",
    "expect __G.helm.active",
    "shot 03-bridge",
    "key down KeyW", "wait 3000", "key up KeyW",
    "key down KeyD", "wait 1500", "key up KeyD",
    "key down Space", "wait 1500", "key up Space",
    "eval (()=>{ const S=__G.war.carrier.sky; return {tel:+S.telV.toFixed(2), helm:+S.helmV.toFixed(2), lift:+S.liftV.toFixed(2)} })()",
    "expect __G.war.carrier.sky.telV > 0.4",
    "wait 8000",
    "eval (()=>{ const c=__G.war.carrier, S=c.sky; return {v:+c.speed.toFixed(1), yawRate:+S.yawRate.toFixed(3), vy:+S.vy.toFixed(2), y:Math.round(c.p.y), heliLanded:__G.H.landed} })()",
    "expect __G.war.carrier.speed > 2 && __G.H.landed",
    "shot 04-bridge-underway",
    "key tap KeyV", "wait 2500",
    "shot 05-outside",
    "key tap Tab", "wait 300",
    "expect !__G.helm.active",
    "log send her over an island from the map: she climbs over it",
    "eval (()=>{ const I=__G.ISLANDS.find(i=>i.name==='CITADEL'); __G.war.orderCarrier(I.x, I.z); return [I.x, I.z] })()",
    "wait 20000",
    "eval ({y:Math.round(__G.war.carrier.p.y), v:+__G.war.carrier.speed.toFixed(1), path:__G.war.carrier.path.length})",
    "expect __G.war.carrier.p.y > 40",
    "key tap KeyC", "wait 2500",
    "shot 06-cruising",
    "log shot down in the air: she falls, and the war is lost",
    "eval (__G.war.damage(__G.war.carrier, 9999, 2), __G.war.carrier.sky.falling)",
    "wait 3000",
    "shot 07-falling",
    "waitFor 30000 __G.G.state === 'title'",
    "expect document.querySelector('#title h1').textContent === 'DEFEAT'"
  ]
}
