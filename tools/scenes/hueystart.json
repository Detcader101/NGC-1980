{
  "name": "hueystart",
  "query": "?debug&kb&peace&cold&cockpit&res=0.45",
  "steps": [
    "waitFor 10000 window.__G",
    "key tap Enter", "wait 1500",
    "log cold and dark on the ALBATROSS deck: nothing turning, no power",
    "expect !__G.H.run && __G.H.rpm < 0.01 && !__G.SY.bat && __G.SY.volts < 1",
    "eval ({hint:document.getElementById('hint').textContent, cautions:__G.SY.cautions})",
    "shot 01-cold-dark",
    "log the -10 start: BATTERY on, MAIN FUEL on, throttle to the idle detent, starter held to 40% N1 (light-off at ~12-15%), release, idle, throttle open",
    "eval (__G.SY.toggle('bat'), __G.D.engineSwitch = true, 1)",
    "wait 500",
    "eval ({volts:+__G.SY.volts.toFixed(1), cautions:__G.SY.cautions})",
    "expect __G.SY.volts > 20 && __G.SY.cautions.includes('ENGINE OIL PRESS') && __G.SY.cautions.includes('DC GENERATOR')",
    "key hold PageUp 400",
    "eval ({grip:+__G.SY.grip.toFixed(2)})",
    "key down Home",
    "waitFor 20000 __G.H.run",
    "eval ({lightoffN1:+__G.H.n1.toFixed(2), egt:+__G.H.egt.toFixed(0), volts:+__G.SY.volts.toFixed(1)})",
    "expect __G.H.n1 > 0.1 && __G.H.n1 < 0.2",
    "shot 02-light-off",
    "waitFor 30000 __G.H.n1 > 0.41",
    "key up Home",
    "waitFor 30000 __G.H.n1 > 0.68",
    "eval ({idleN1:+__G.H.n1.toFixed(2), nr:+__G.H.rpm.toFixed(2), egt:+__G.H.egt.toFixed(0), gen:__G.SY.cautions.includes('DC GENERATOR')})",
    "shot 03-idle",
    "key hold PageUp 2600",
    "waitFor 20000 __G.H.rpm > 0.985",
    "wait 2000",
    "eval ({n2:+__G.H.n2.toFixed(3), nr:+__G.H.rpm.toFixed(3), n1:+__G.H.n1.toFixed(2), egt:+__G.H.egt.toFixed(0), grip:+__G.SY.grip.toFixed(2), cautions:__G.SY.cautions, hint:document.getElementById('hint').textContent})",
    "expect Math.abs(__G.H.rpm - 1) < 0.015 && __G.H.landed && __G.Z.alive && __G.H.egt < 760",
    "shot 04-governed",
    "log shut down (I) and the one-key start (I again)",
    "key tap KeyI",
    "waitFor 20000 !__G.H.run && __G.H.n1 < 0.3",
    "key tap KeyI",
    "waitFor 40000 __G.H.run && __G.H.rpm > 0.985 && __G.SY.grip > 0.99",
    "eval ({n1:+__G.H.n1.toFixed(2), nr:+__G.H.rpm.toFixed(3), egt:+__G.H.egt.toFixed(0)})",
    "expect __G.H.landed && __G.Z.alive"
  ]
}
