{
  "name": "jets",
  "query": "?debug&kb&peace&res=0.45",
  "steps": [
    "waitFor 10000 window.__G",
    "key tap Enter",
    "wait 1200",
    "log a Tomcat to the cat (real flight model, AI pilot): run-up, shot, climb-out; close-up from a hovering helicopter",
    "eval (()=>{ const W=__G.war, c=W.carrier; c.path=[]; __G.G.mat=200; __G.selIsl=null; __G.command(4); __G.H.reset(new __G.THREE.Vector3(c.p.x+20, c.p.y+18, c.p.z-20), c.yaw, false, 1); __G.HI.setCollective(0.475); return W.air.pending.length })()",
    "waitFor 90000 __G.war.units.some(u=>u.type==='escort' && u.ai.state==='cat')",
    "eval (window.__j = __G.war.units.find(u=>u.type==='escort'), {state:__j.ai.state, sweep:__j.sim.sweep, flap:__j.sim.flapSel, launchBar:__j.sim.launchBar})",
    "wait 2500",
    "shot 01-catapult",
    "waitFor 90000 __j.ai.state==='climb'",
    "eval (window.__t0=__G.war.time, 1)",
    "waitFor 30000 __G.war.time - __t0 >= 2.5",
    "shot 02-climbout",
    "eval ({state:__j.ai.state, y:Math.round(__j.p.y), eas:Math.round(__j.sim.eas*1.944), gear:__j.sim.gear, sweep:Math.round(__j.sim.sweep)})",
    "expect !__j.dead && !__j.dying && __j.sim.gearCmd === 0",
    "log dogfight: two more Tomcats, three enemy gunships near the helicopter",
    "eval (__G.command(4), __G.command(4), 1)",
    "waitFor 240000 __G.war.units.filter(u=>u.type==='escort' && ['cap','fight'].includes(u.ai.state)).length === 3",
    "eval (()=>{ const P=__G.H.pos; window.__gs=[0,1,2].map(i=>__G.war.spawnGunship(2,[P.x+120+i*10, P.y+20, P.z-80])); return 1 })()",
    "key tap KeyC",
    "wait 6000",
    "shot 03-dogfight",
    "waitFor 60000 __gs.every(g=>g.dead||g.dying)",
    "eval ({gunshipsLeft:__gs.filter(g=>!g.dead&&!g.dying).length, escorts:__G.war.units.filter(u=>u.type==='escort').map(u=>[u.name,u.ai.state,u.hp,u.sim.stores.filter(s=>s.on).length,u.sim.gun]), t:Math.round(__G.war.time)})",
    "expect __gs.every(g=>g.dead||g.dying)"
  ]
}
